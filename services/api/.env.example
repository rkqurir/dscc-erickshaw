# Runtime connection: least-privilege role (RLS enforced)
DATABASE_URL=postgresql://dscc_app:dscc_app_dev@localhost:5432/dscc_dev
# Migrations & seed: schema owner
MIGRATION_DATABASE_URL=postgresql://dscc_owner:dscc_owner_dev@localhost:5432/dscc_dev
APP_DB_ROLE=dscc_app
PORT=4000
NODE_ENV=development
CITY_CODE=DSCC
# 32-byte keys, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
NID_HMAC_KEY=
OTP_HMAC_KEY=
SESSION_HMAC_KEY=
# Adapters: only simulators exist until Gate D approval of live integrations
SMS_PROVIDER=simulator
NID_VERIFICATION_PROVIDER=simulator
STORAGE_DIR=./storage
COOKIE_SECURE=false
