{
  "name": "@dscc/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node dist/seed/seed.js",
    "staff:create": "node dist/seed/create-staff.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@dscc/domain": "workspace:*",
    "@dscc/localization": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "@swc/core": "1.13.5",
    "vitest": "3.2.4"
  }
}
